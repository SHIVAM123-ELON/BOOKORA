# ====================================================================
# BOOKORA PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ====================================================================

# ENVIRONMENT MODE
# Values: development | staging | production
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# ====================================================================
# SECURITY & AUTHENTICATION
# ====================================================================
# Cryptographically secure 256-bit string (min 32 chars)
JWT_SECRET=your_production_jwt_secret_min_32_characters_long_replace_me
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
SIGNED_URL_SECRET=your_production_signed_url_secret_key_v1

# ====================================================================
# DATABASE (PostgreSQL Clustered Connection)
# ====================================================================
DATABASE_URL=postgresql://bookora_user:secure_password_replace@db.internal:5432/bookora_prod
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=25
DB_MAX_LIFETIME_MS=1800000
DB_CONNECTION_TIMEOUT_MS=10000

# ====================================================================
# REDIS (Distributed Cache, Rate Limiter & Lock Manager)
# ====================================================================
REDIS_URL=redis://:secure_redis_password@redis.internal:6379/0
REDIS_TLS_ENABLED=true

# ====================================================================
# OBJECT STORAGE (E-Book Vault & Public Asset CDN)
# ====================================================================
OBJECT_STORAGE_PROVIDER=s3 # Options: s3 | gcs | azure
OBJECT_STORAGE_BUCKET=bookora-vault-production
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=your_aws_or_gcs_access_key
OBJECT_STORAGE_SECRET_KEY=your_aws_or_gcs_secret_key
CDN_PUBLIC_BASE_URL=https://cdn.bookora.com

# ====================================================================
# AI / GEMINI ENGINE
# ====================================================================
# Configured via AI Studio Secrets Panel or server-side secret store
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
AI_RATE_LIMIT_PER_MINUTE=15

# ====================================================================
# PAYMENT GATEWAY & FINANCIAL WORKFLOWS
# ====================================================================
ALLOW_MOCK_PAYMENTS=true
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_key
PLATFORM_COMMISSION_PERCENTAGE=30.0

# ====================================================================
# OBSERVABILITY, SENTRY & MONITORING
# ====================================================================
SENTRY_DSN=https://your_sentry_key@o0000.ingest.sentry.io/0000000
METRICS_PORT=9090
PROMETHEUS_ENABLED=true
